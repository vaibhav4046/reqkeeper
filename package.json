{
  "name": "reqkeeper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Exactly-once settlement of Request Network obligations through KeeperHub.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test",
    "typecheck": "tsc --noEmit",
    "gate-a": "node --experimental-strip-types scripts/gate-a.ts",
    "harness": "node --experimental-strip-types scripts/harness.ts",
    "verify:onchain": "node --experimental-strip-types scripts/verify-onchain.ts",
    "verify:seam": "node --experimental-strip-types scripts/verify-seam.ts",
    "settle:live": "node --experimental-strip-types scripts/settle-live.ts",
    "mcp": "node --experimental-strip-types scripts/mcp-server.ts",
    "approve": "node --experimental-strip-types scripts/approve.ts",
    "demo": "node --experimental-strip-types scripts/demo.ts",
    "demo:video": "node --experimental-strip-types scripts/demo.ts && node tools/video/render.mjs docs/demo-transcript.txt docs/demo.mp4",
    "build": "node tools/web/build.mjs && tsc -p tsconfig.api.json",
    "build:web": "node tools/web/build.mjs",
    "harness:live": "node --experimental-strip-types scripts/live-harness.ts",
    "probe:mcp": "node --experimental-strip-types scripts/verify-mcp.ts",
    "invoices": "node tools/invoice/create-batch.mjs",
    "verify:live": "node --experimental-strip-types scripts/verify-live.ts",
    "resolve": "node --experimental-strip-types scripts/resolve.ts",
    "watch": "node --experimental-strip-types scripts/watch-request.ts",
    "build:api": "tsc -p tsconfig.api.json"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "5.9"
  }
}
