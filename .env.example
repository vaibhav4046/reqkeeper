# The only credential the settle path needs.
KEEPERHUB_API_KEY=

# Where a live payment is sent. Set by tools/invoice/create-batch.mjs.
PAYEE_ADDRESS=

# Written by tools/invoice/create-batch.mjs. A burner keypair generated locally, used only to
# sign the Request invoice; it is the payee, so no existing wallet's key is ever needed.
INVOICE_SIGNER_KEY=
PAYEE_BURNER=

# Facts of the most recent single invoice, written by tools/invoice/create-invoice.mjs and read
# by scripts/settle-live.ts. The batch harness reads docs/live-invoices.json instead.
REQUEST_ID=
PAYMENT_REFERENCE=
PAYMENT_SALT=
FEE_ADDRESS=
FEE_AMOUNT=

# Not needed. Request's v2 REST API wants one of these, but this project creates invoices
# through the protocol gateway, which is unauthenticated. Left here only to say so.
# REQUEST_CLIENT_ID=
# REQUEST_API_KEY=

# The operator's standing policy — the ceilings the invoice cannot raise. UNSET BY DEFAULT, and
# while unset every allowlist and cap comes from the invoice itself, so the policy gate can only
# catch facts that change after approval. Set these two to make it a real gate.
# REQKEEPER_ALLOWED_PAYEES=0xabc…,0xdef…
# REQKEEPER_MAX_DEBIT=25000000000000000000
# Optional companions to the two above.
# REQKEEPER_ALLOWED_FEE_RECIPIENTS=
# REQKEEPER_MAX_FEE=
