# The only credential the settle path needs.
KEEPERHUB_API_KEY=

# Where a live payment is sent. Set by tools/invoice/create-batch.mjs.
PAYEE_ADDRESS=

# Written by tools/invoice/create-batch.mjs. A burner keypair generated locally, used only to
# sign the Request invoice; it is the payee, so no existing wallet's key is ever needed.
INVOICE_SIGNER_KEY=
PAYEE_BURNER=

# Facts of the most recent single invoice, written by tools/invoice/create-invoice.mjs and read
# by scripts/settle-live.ts. The batch harness reads docs/live-invoices.json instead.
REQUEST_ID=
PAYMENT_REFERENCE=
PAYMENT_SALT=
FEE_ADDRESS=
FEE_AMOUNT=

# Not needed. Request's v2 REST API wants one of these, but this project creates invoices
# through the protocol gateway, which is unauthenticated. Left here only to say so.
# REQUEST_CLIENT_ID=
# REQUEST_API_KEY=

# The operator's standing policy — the ceilings the invoice cannot raise. UNSET BY DEFAULT, and
# while unset every allowlist and cap comes from the invoice itself, so the policy gate can only
# catch facts that change after approval. Set these two to make it a real gate.
# REQKEEPER_ALLOWED_PAYEES=0xabc…,0xdef…
# REQKEEPER_MAX_DEBIT=25000000000000000000
# Optional companions to the two above.
# REQKEEPER_ALLOWED_FEE_RECIPIENTS=
# REQKEEPER_MAX_FEE=

# ---- chain reads -----------------------------------------------------------------------------
# The endpoint every read uses. Unset means a public one, which rate-limits a fresh clone on the
# first `npm run watch`.
# SEPOLIA_RPC=https://your-endpoint

# The endpoints a NEGATIVE is corroborated against, comma-separated. One endpoint's empty
# eth_getLogs has been wrong in production for a payment that demonstrably exists, so a negative
# nothing else confirms is treated as "I could not tell" -- which refuses rather than pays. Unset
# means three public defaults, one of which (drpc) refuses free-tier traffic outright, leaving a
# quorum of two.
# REQKEEPER_RPC_ENDPOINTS=https://a,https://b

# How deep a receipt must be before a payment counts as settled. Default 2.
# REQKEEPER_MIN_CONFIRMATIONS=2

# ---- the leak-exclusion proof ------------------------------------------------------------------
# The account that BROADCASTS. On this deployment that is KeeperHub's relayer, not the funding
# account: the payment is a transferFrom, so the funding account's tokens move while the relayer's
# nonce is the one spent. docs/RUNBOOK.md shows how to discover it.
# REQKEEPER_PAYER_ADDRESS=0x…

# Asserted by a human, never inferred, and it must stay FALSE for a shared relayer.
#
# A dry run whose reply was lost may have broadcast. The only fact that proves it can never be
# mined is another transaction occupying the nonce it would have used -- and that proof is worth
# nothing on an account other things broadcast from. KeeperHub's relayer went from nonce 25786 to
# 30078 while this was being built, so "the nonce moved" there is a near-certain automatic yes.
# Setting this true for a shared account buys a false proof and a second payment.
# REQKEEPER_PAYER_IS_DEDICATED=false

# Which KeeperHub transport `npm run settle:live` uses: rest (default) or mcp. An unrecognised
# value is refused rather than silently defaulted.
# KEEPERHUB_TRANSPORT=rest
